# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:secret@localhost:5432/campaign_analytics?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET="change-me-to-a-very-long-random-secret-at-least-256-bits"
JWT_EXPIRES_IN="1h"

# ─── Test Database (used by Jest) ────────────────────────────────────────────────
TEST_DATABASE_URL="postgresql://postgres:secret@localhost:5432/campaign_analytics_test?schema=public"
