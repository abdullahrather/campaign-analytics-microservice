// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// A person's level across the whole platform.
enum Role {
  ADMIN
  ADVERTISER
  GUEST
}

/// A person's level inside one organisation.
enum OrganisationRole {
  OWNER
  MANAGER
  ANALYST
}

/// PROCESSING -> PENDING_REVIEW -> APPROVED or REJECTED. FAILED means the video couldn't be converted.
enum CreativeStatus {
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

/// Where an ad runs inside an episode.
enum AdSlot {
  PRE_ROLL
  MID_ROLL
  POST_ROLL
}

enum Device {
  CTV
  MOBILE
  WEB
  TABLET
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

/// A person who can sign in.
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String    @default("")
  passwordHash         String    @map("password_hash")
  role                 Role      @default(ADVERTISER)
  emailVerifiedAt      DateTime? @map("email_verified_at") @db.Timestamptz(3)
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamptz(3)
  /// Encrypted. Only active once twoFactorEnabledAt is set.
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorEnabledAt   DateTime? @map("two_factor_enabled_at") @db.Timestamptz(3)
  /// The last accepted code's time step, so a code can't be used twice.
  twoFactorLastStep    BigInt?   @map("two_factor_last_step")
  /// Wrong codes in a row. Counted per account, because guesses can come from many addresses.
  twoFactorFailures    Int       @default(0) @map("two_factor_failures")
  twoFactorLockedUntil DateTime? @map("two_factor_locked_until") @db.Timestamptz(3)
  /// Hashed, one-use codes for a lost authenticator.
  recoveryCodes        String[]  @default([]) @map("recovery_codes")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaigns   Campaign[]
  memberships Membership[]
  sessions    Session[]
  tokens      OneTimeToken[]
  invitations Invitation[]

  @@map("users")
}

/// A company using the platform. Campaigns belong here, not to one person.
model Organisation {
  id          String    @id @default(cuid())
  name        String
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships Membership[]
  campaigns   Campaign[]
  invitations Invitation[]
  sessions    Session[]

  @@map("organisations")
}

model Membership {
  userId         String           @map("user_id")
  organisationId String           @map("organisation_id")
  role           OrganisationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([userId, organisationId])
  @@index([organisationId])
  @@map("memberships")
}

/// Only hashes of invitation tokens are stored.
model Invitation {
  id             String           @id @default(cuid())
  organisationId String           @map("organisation_id")
  email          String
  role           OrganisationRole
  tokenHash      String           @unique @map("token_hash")
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("invitations")
}

/// One signed-in device. Refresh tokens rotate; only their hashes are stored.
model Session {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  activeOrganisationId String?   @map("active_organisation_id")
  refreshHash          String    @map("refresh_hash")
  previousRefreshHash  String?   @map("previous_refresh_hash")
  rotatedAt            DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent            String    @default("") @map("user_agent")
  ipAddress            String    @default("") @map("ip_address")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganisation Organisation? @relation(fields: [activeOrganisationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/// Single-use links for email verification and password reset.
model OneTimeToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("one_time_tokens")
}

/// Append-only history of who changed what. Survives deleted users and organisations.
model AuditLog {
  id             String   @id @default(cuid())
  organisationId String?  @map("organisation_id")
  actorId        String?  @map("actor_id")
  actorEmail     String   @default("") @map("actor_email")
  action         String
  targetType     String   @default("") @map("target_type")
  targetId       String   @default("") @map("target_id")
  details        Json     @default("{}")
  ipAddress      String   @default("") @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organisationId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Emails kept for the local mailbox when no mail server is configured.
model CapturedEmail {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  body      String
  link      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("captured_emails")
}

/// A title in the streaming catalogue that ads can run against.
model Show {
  id       String @id @default(cuid())
  title    String @unique
  genre    String
  /// Storage key of the demo episode. Empty when no video exists.
  videoKey String @default("") @map("video_key")

  metrics Metric[]

  @@map("shows")
}

/// An advertising campaign owned by an Organisation. userId is whoever created it.
/// Empty target lists mean "all".
model Campaign {
  id              String         @id @default(cuid())
  organisationId  String         @map("organisation_id")
  userId          String         @map("user_id")
  title           String
  advertiser      String
  status          CampaignStatus @default(ACTIVE)
  budgetCents     Int            @map("budget_cents")
  cpmCents        Int            @map("cpm_cents")
  impressionGoal  Int            @map("impression_goal")
  startsAt        DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime       @map("ends_at") @db.Timestamptz(3)
  targetCountries String[]       @default([]) @map("target_countries")
  targetGenres    String[]       @default([]) @map("target_genres")
  targetDevices   Device[]       @default([]) @map("target_devices")
  targetSlots     AdSlot[]       @default([]) @map("target_slots")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics      Metric[]
  creatives    Creative[]

  @@index([organisationId])
  @@index([userId])
  @@index([status, startsAt, endsAt])
  @@map("campaigns")
}

/// A video ad. It can only run once a platform admin has approved it.
model Creative {
  id              String         @id @default(cuid())
  campaignId      String         @map("campaign_id")
  name            String
  clickUrl        String         @map("click_url")
  status          CreativeStatus @default(PROCESSING)
  /// Storage keys. The original is removed after conversion.
  originalKey     String         @default("") @map("original_key")
  videoKey        String         @default("") @map("video_key")
  posterKey       String         @default("") @map("poster_key")
  durationSeconds Float          @default(0) @map("duration_seconds")
  width           Int            @default(0)
  height          Int            @default(0)
  sizeBytes       Int            @default(0) @map("size_bytes")
  failureReason   String         @default("") @map("failure_reason")
  rejectionReason String         @default("") @map("rejection_reason")
  createdById     String         @map("created_by_id")
  reviewedById    String?        @map("reviewed_by_id")
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([status, createdAt])
  @@map("creatives")
}

/// Hourly rollup of ad events. One row per campaign, hour, show, slot, country
/// and device, so reads stay fast however many raw events arrive.
model Metric {
  campaignId     String   @map("campaign_id")
  showId         String   @map("show_id")
  slot           AdSlot
  country        String   @db.Char(2)
  device         Device
  bucket         DateTime @db.Timestamptz(3)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  /// How many viewers reached 25%, 50% and 75% of the ad.
  firstQuartiles Int      @default(0) @map("first_quartiles")
  midpoints      Int      @default(0)
  thirdQuartiles Int      @default(0) @map("third_quartiles")
  completions    Int      @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  show     Show     @relation(fields: [showId], references: [id], onDelete: Restrict)

  @@id([campaignId, bucket, showId, slot, country, device])
  @@index([bucket])
  @@map("metrics")
}
