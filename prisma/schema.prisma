// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ADVERTISER
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

/// Where an ad runs inside an episode.
enum AdSlot {
  PRE_ROLL
  MID_ROLL
  POST_ROLL
}

enum Device {
  CTV
  MOBILE
  WEB
  TABLET
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

/// Platform user — can be an Admin or an Advertiser.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADVERTISER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaigns Campaign[]

  @@map("users")
}

/// A title in the streaming catalogue that ads can run against.
model Show {
  id    String @id @default(cuid())
  title String @unique
  genre String

  metrics Metric[]

  @@map("shows")
}

/// An advertising campaign owned by a User. Empty target lists mean "all".
model Campaign {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  title           String
  advertiser      String
  status          CampaignStatus @default(ACTIVE)
  budgetCents     Int            @map("budget_cents")
  cpmCents        Int            @map("cpm_cents")
  impressionGoal  Int            @map("impression_goal")
  startsAt        DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime       @map("ends_at") @db.Timestamptz(3)
  targetCountries String[] @default([]) @map("target_countries")
  targetGenres    String[] @default([]) @map("target_genres")
  targetDevices   Device[] @default([]) @map("target_devices")
  targetSlots     AdSlot[] @default([]) @map("target_slots")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics Metric[]

  @@index([userId])
  @@index([status, startsAt, endsAt])
  @@map("campaigns")
}

/// Hourly rollup of ad events. One row per campaign, hour, show, slot, country
/// and device, so reads stay fast however many raw events arrive.
model Metric {
  campaignId  String   @map("campaign_id")
  showId      String   @map("show_id")
  slot        AdSlot
  country     String   @db.Char(2)
  device      Device
  bucket      DateTime @db.Timestamptz(3)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  completions Int      @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  show     Show     @relation(fields: [showId], references: [id], onDelete: Restrict)

  @@id([campaignId, bucket, showId, slot, country, device])
  @@index([bucket])
  @@map("metrics")
}
